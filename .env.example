# JobFit AI — environment template. Copy to .env. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://jobfit:jobfit@postgres:5432/jobfit
# Local dev fallback (SQLite) when Postgres is unavailable:
# DATABASE_URL=sqlite+aiosqlite:///./jobfit.db
REDIS_URL=redis://redis:6379/0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_ENABLED=false
FILE_STORAGE_PATH=/tmp/jobfit_storage
MAX_UPLOAD_SIZE=10485760
LOG_LEVEL=INFO
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Scoring weights (must sum ~1.0)
WEIGHT_MANDATORY=0.40
WEIGHT_PREFERRED=0.15
WEIGHT_EXPERIENCE=0.20
WEIGHT_SKILL=0.15
WEIGHT_TRANSFERABILITY=0.05
WEIGHT_CONFIDENCE=0.05
SEMANTIC_THRESHOLD=0.62
TRANSFERABLE_THRESHOLD=0.55
# RL decision layer (additive; set RL_ENABLED=false to force base matcher)
RL_ENABLED=true
RL_MODEL_PATH=backend/app/nlp/rl/models/rl_policy.json
RL_MIN_OVERRIDE_CONF=0.55
